{
  "sourceLanguage" : "pt-BR",
  "strings" : {
    "#%@" : {
      "comment" : "A subheading displaying the Pokédex ID of a Pokémon. The argument is the string “%04d”.",
      "isCommentAutoGenerated" : true
    },
    "%@, #%lld" : {
      "comment" : "A label that describes the image as a combination of the Pokémon's name and its Pokédex ID.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, #%2$lld"
          }
        }
      }
    },
    "%@: %lld" : {
      "comment" : "A label that describes the stat and its value.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$lld"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A subheading displaying the value of a Pokémon's stat. The first argument is the name of the stat. The second argument is the value of the stat.",
      "isCommentAutoGenerated" : true
    },
